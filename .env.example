# --- core ---
DATABASE_URL=postgresql+asyncpg://brain:brain@postgres:5432/brain
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# --- storage (MinIO locally, S3/GCS in prod) ---
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=documents
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# --- providers: pick implementations by name (see app/providers/factory.py) ---
LLM_PROVIDER=openai            # openai | anthropic | ollama
LLM_MODEL=
EMBEDDING_PROVIDER=openai      # openai | voyage | local
EMBEDDING_MODEL=
EMBEDDING_DIM=1536             # must match the vector(N) column
RERANK_PROVIDER=local          # cohere | voyage | local | none
RERANK_MODEL=BAAI/bge-reranker-v2-m3
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=

# --- retrieval defaults (the eval sweeps these) ---
CHUNK_TOKENS=500
CHUNK_OVERLAP=75
RETRIEVE_K=30
RERANK_TOP_N=6
RRF_K=60

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
